/* =========================
   HALAMAN HOME
========================= */

.home {

  min-height: 100vh;

  display: flex;

  justify-content: center;

  align-items: center;

  text-align: center;

  padding: 80px 20px;
}


/* JUDUL */

.home h1 {

  font-size: 45px;

  margin-bottom: 15px;
}


/* DESKRIPSI */

.home p {

  font-size: 17px;

  margin-bottom: 25px;
}


/* TOMBOL */

.button {

  display: inline-block;

  padding: 12px 25px;

  background: #333;

  color: white;

  border-radius: 25px;

  transition: 0.3s;
}


/* EFEK TOMBOL */

.button:hover {

  transform: translateY(-2px);

  opacity: 0.8;
}


/* TENTANG */

.about {

  min-height: 50vh;

  padding: 80px 20px;

  text-align: center;
}

.about h2 {

  font-size: 30px;

  margin-bottom: 20px;
}


/* HP */

@media (max-width: 600px) {

  .home h1 {
    font-size: 32px;
  }

  .home p {
    font-size: 15px;
  }

}
